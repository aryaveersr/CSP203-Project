{
  "name": "campus-hub",
  "version": "1.0.0",
  "description": "Campus Hub Course Project",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
